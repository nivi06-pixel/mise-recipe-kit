{
  "version": 1,
  "id": "mise.ShareCard",
  "templateVersion": "2.0.0",
  "label": "Recipe share image",
  "description": "A recipe's share image for Pinterest, feeds and stories: its name and hook, then a photo of the dish, and the numbers that matter.",
  "root": "Canvas",
  "guidance": "Lead with the dish's name as people would search for it. Keep the hook to one sentence a friend would say.",
  "formats": {
    "pin": {
      "width": 1000,
      "height": 1500
    },
    "square": {
      "width": 1080,
      "height": 1080
    },
    "story": {
      "width": 1080,
      "height": 1920
    }
  },
  "fields": [
    {
      "path": "title",
      "kind": "text",
      "label": "Dish name",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 48,
        "minLength": 1
      },
      "guidance": "The name people search for: 'Chocolate Chip Cookies', not 'Little bites of joy'."
    },
    {
      "path": "kicker",
      "kind": "text",
      "label": "Kicker",
      "description": "Small line above the name: a cuisine, a course.",
      "required": false,
      "schema": {
        "type": "string",
        "maxLength": 32
      }
    },
    {
      "path": "hook",
      "kind": "text",
      "label": "Hook",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 110,
        "minLength": 1
      },
      "guidance": "One sentence: why cook this tonight."
    },
    {
      "path": "totalTime",
      "kind": "text",
      "label": "Total time",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 14,
        "minLength": 1
      }
    },
    {
      "path": "serves",
      "kind": "text",
      "label": "Serves",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 14,
        "minLength": 1
      }
    },
    {
      "path": "tags",
      "kind": "list",
      "label": "Tags",
      "required": false,
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 18
        },
        "maxItems": 3
      }
    },
    {
      "path": "tags[]",
      "kind": "text",
      "label": "Tag",
      "required": false,
      "schema": {
        "type": "string",
        "maxLength": 18
      }
    },
    {
      "path": "accent",
      "kind": "color",
      "label": "Accent",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "path": "photo",
      "kind": "image",
      "label": "Dish photo",
      "description": "The finished dish, landscape. It fills its box in each format, cropped from the centre.",
      "required": true,
      "schema": {
        "type": "object",
        "required": [
          "src",
          "width",
          "height"
        ],
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      },
      "fit": "cover",
      "aspect": {
        "min": 1.2,
        "max": 1.8
      },
      "minWidth": 1200,
      "accepts": [
        "jpeg",
        "png",
        "webp"
      ],
      "maxCrop": 0.6,
      "guidance": "A real photo of this dish, plated, in daylight. No text or logos in the picture.",
      "regions": {
        "pin": {
          "box": [
            840,
            560
          ],
          "pixels": [
            840,
            560
          ]
        },
        "square": {
          "box": [
            420,
            640
          ],
          "pixels": [
            420,
            640
          ]
        },
        "story": {
          "box": [
            920,
            860
          ],
          "pixels": [
            920,
            860
          ]
        }
      },
      "suggested": {
        "width": 920,
        "height": 860,
        "crop": {
          "pin": "cuts 29% of the height",
          "square": "cuts 39% of the width",
          "story": "crops nothing"
        }
      }
    },
    {
      "path": "credit",
      "kind": "text",
      "label": "Photo credit",
      "description": "Who took the photo: shown small in its corner.",
      "required": true,
      "schema": {
        "type": "string",
        "maxLength": 40,
        "minLength": 1
      }
    }
  ],
  "rules": {
    "lint": [],
    "core": []
  },
  "theme": {
    "tokens": [
      {
        "path": "colors.background",
        "group": "colors",
        "value": "#fbf6ee"
      },
      {
        "path": "colors.foreground",
        "group": "colors",
        "value": "#2b2118"
      },
      {
        "path": "colors.primary",
        "group": "colors",
        "value": "#8a3e17"
      },
      {
        "path": "colors.primaryForeground",
        "group": "colors",
        "value": "#ffffff"
      },
      {
        "path": "colors.muted",
        "group": "colors",
        "value": "#7a6a5a"
      },
      {
        "path": "colors.border",
        "group": "colors",
        "value": "#e6d9c6"
      },
      {
        "path": "colors.paper",
        "group": "colors",
        "value": "#fffdf8"
      },
      {
        "path": "colors.soft",
        "group": "colors",
        "value": "#f3eadb"
      },
      {
        "path": "colors.ink",
        "group": "colors",
        "value": "#2b2118"
      },
      {
        "path": "fonts.body",
        "group": "fonts",
        "value": "Inter, Helvetica, Arial, sans-serif"
      },
      {
        "path": "fonts.heading",
        "group": "fonts",
        "value": "Fraunces, Georgia, 'Times New Roman', serif"
      }
    ],
    "roles": [
      "colors.background",
      "colors.foreground",
      "fonts.body",
      "fonts.heading",
      "colors.primary",
      "colors.primaryForeground",
      "colors.border"
    ],
    "styles": [
      "card",
      "eyebrow",
      "chip"
    ],
    "elements": [
      {
        "type": "Heading",
        "variants": [],
        "by": "level"
      },
      {
        "type": "Button",
        "variants": [
          "ghost"
        ]
      },
      {
        "type": "Divider",
        "variants": []
      }
    ],
    "components": [
      {
        "type": "Heading",
        "variants": [],
        "by": "level"
      },
      {
        "type": "Button",
        "variants": [
          "ghost"
        ]
      },
      {
        "type": "Divider",
        "variants": []
      }
    ]
  },
  "valuesSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "hook",
      "totalTime",
      "serves",
      "accent",
      "photo",
      "credit"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 48,
        "minLength": 1
      },
      "kicker": {
        "type": "string",
        "maxLength": 32
      },
      "hook": {
        "type": "string",
        "maxLength": 110,
        "minLength": 1
      },
      "totalTime": {
        "type": "string",
        "maxLength": 14,
        "minLength": 1
      },
      "serves": {
        "type": "string",
        "maxLength": 14,
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 18
        },
        "maxItems": 3
      },
      "accent": {
        "type": "string"
      },
      "photo": {
        "type": "object",
        "required": [
          "src",
          "width",
          "height"
        ],
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      },
      "credit": {
        "type": "string",
        "maxLength": 40,
        "minLength": 1
      }
    }
  },
  "fixed": "Everything not listed: the layout, typography, colors, the fixed text and images, and the arrangement per format."
}